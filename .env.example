OPENAI_BASIC_AUTH_USERNAME=
OPENAI_BASIC_AUTH_PASSWORD=
OPENAI_SYSTEM_PROMPT=あなたはデスクトップに常駐する日本語のAItuberです。ユーザーの発話内容を踏まえ、自然で簡潔な返答をしてください。最初の一文は20文字以内にし、その後に詳しく続けてください。

NEXT_PUBLIC_VTUBE_STUDIO_WS_URL=ws://127.0.0.1:8001
NEXT_PUBLIC_VTUBE_STUDIO_PLUGIN_NAME=tofu-madobe
NEXT_PUBLIC_VTUBE_STUDIO_PLUGIN_DEVELOPER=tofu

# These are server-side only. The demo mode does not read or call any of them.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.5-flash-lite

TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest

ELEVENLABS_API_KEY=

# Local UtauTTS should listen on loopback; the app rejects non-loopback URLs.
UTAUTTS_BASE_URL=http://127.0.0.1:18080
UTAUTTS_AUTH_TOKEN=
UTAUTTS_VOICEBANK_ID=yub4
UTAUTTS_RENDERER=utautts-world-phrase
UTAUTTS_MODEL_ID=frame-intonation-v8
UTAUTTS_ENGINE=UtauTTS / yub4
